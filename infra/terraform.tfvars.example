# Copie para terraform.tfvars e ajuste. O arquivo terraform.tfvars está no
# .gitignore justamente para não versionar configurações locais.

aws_region    = "us-east-1"
project_name  = "taskflow"
environment   = "dev"
instance_type = "t3.micro"

# Imagem promovida pelo pipeline de CD. É esta tag que o Watchtower observa.
container_image = "ghcr.io/levimbraga/taskflow-api:latest"

# Repositório de onde a instância baixa docker-compose.yml e o diretório ops/.
repo_url = "https://github.com/levimbraga/taskflow-api.git"
repo_ref = "main"

# Grafana e Prometheus só respondem para este CIDR. O padrão do código
# (127.0.0.1/32) deixa as portas fechadas; troque pelo seu IP para acessar.
observability_ingress_cidr = "SEU.IP.AQUI/32"
grafana_admin_user         = "admin"

# Sem valor padrão de propósito: defina aqui, exporte como TF_VAR_grafana_admin_password
# ou informe no prompt do terraform. Mínimo de 12 caracteres.
grafana_admin_password = "troque-esta-senha"

# Só habilite SSH se realmente precisar, e sempre restringindo ao seu IP.
enable_ssh       = false
ssh_ingress_cidr = "SEU.IP.AQUI/32"
key_pair_name    = ""
